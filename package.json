{
  "name": "anythingplugin",
  "version": "0.1.0",
  "description": "A desktop app framework: Electron + Vue 3 + electron-vite + pnpm, with plugin UI hosted by Web Components.",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "dsh:smoke": "node scripts/dsh-smoke.mjs",
    "package:sidecar": "node scripts/package-sidecar.mjs",
    "create:plugin": "node scripts/create-plugin.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:plugin:watch": "node scripts/build-plugin.mjs --watch",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && npm run package:sidecar && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dompurify": "^3.4.13",
    "extract-zip": "^2.0.1",
    "marked": "^18.0.9",
    "pinyin-pro": "^3.29.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.11",
    "element-plus": "^2.14.4",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.21.0"
}
